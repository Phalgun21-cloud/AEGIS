ENVIRONMENT=development
# Local MySQL 8 (MySQL Workbench / MySQL80 service). Create the DB + user with
# backend/scripts/mysql_setup.sql, then put the password you chose here.
DATABASE_URL=mysql+pymysql://aegis:CHANGE_ME@localhost:3306/aegis
CORS_ORIGINS=http://localhost:3000

# Must be a random 32+ char value outside development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-in-production
ACCESS_TOKEN_MINUTES=30

# Vault RSA private key. Development: auto-generated at VAULT_PRIVATE_KEY_FILE on first use.
# Production: put the PEM in VAULT_PRIVATE_KEY (platform secret); "\n" escapes are accepted.
VAULT_PRIVATE_KEY_FILE=keys/vault_private.pem
# VAULT_PRIVATE_KEY=

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15
DUPLICATE_THRESHOLD=0.85

# Phase 4 (optional): anchor the audit-chain head on a blockchain. Testnet/local only.
# Local:   npm run chain  (Hardhat node)  then  npm run deploy:local  -> prints the address.
# Sepolia: deploy with contracts/.env, then use your Sepolia RPC URL and the deployer key.
ANCHOR_ENABLED=false
ANCHOR_RPC_URL=http://127.0.0.1:8545
ANCHOR_CONTRACT_ADDRESS=
# Private key of the account that deployed (owns) the contract. Keep it secret; test wallet only.
ANCHOR_PRIVATE_KEY=
ANCHOR_CHAIN_ID=0
ANCHOR_MIN_INTERVAL_SECONDS=60
